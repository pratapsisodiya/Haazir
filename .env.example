# Copy to .env and fill in. Every value is validated at startup (packages/shared/src/env.ts);
# a missing or malformed value stops the process with a message saying which one.

# NODE_ENV defaults to development. Hosting sets production; do not set it here,
# Vite reads this file too and would build the dashboard in dev mode.
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace
APP_URL=http://localhost:5173
API_URL=http://localhost:4000
DATABASE_URL=postgres://haazir:haazir@localhost:5432/haazir
DATABASE_URL_TEST=postgres://haazir:haazir@localhost:5432/haazir_test
REDIS_URL=redis://localhost:6379

ENCRYPTION_KEY=                 # 32-byte base64, AES-256-GCM for tokens: openssl rand -base64 32
BETTER_AUTH_SECRET=             # openssl rand -base64 32 (used from Phase 3)

# WhatsApp (Phase 1)
META_APP_ID=
META_APP_SECRET=                # webhook signature verification (App settings > Basic)
META_WEBHOOK_VERIFY_TOKEN=      # any random string; paste the same into the Meta webhook form
META_GRAPH_API_VERSION=v26.0    # pinned; bump only after reading Meta's changelog
# META_GRAPH_BASE_URL=http://localhost:4010   # only to use scripts/mock-graph.ts locally
WHATSAPP_PHONE_NUMBER_ID=       # WhatsApp > API Setup, "Phone number ID"
WHATSAPP_WABA_ID=               # "WhatsApp Business Account ID"
WHATSAPP_ACCESS_TOKEN=          # system-user token; stored encrypted by `pnpm whatsapp:connect`
WHATSAPP_ORG_SLUG=shiksha-computer-sikar

# AI (Phase 2)
LLM_PROVIDER=openai             # openai | anthropic | google | azure
LLM_FAST_MODEL=
LLM_SMART_MODEL=
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
STT_PROVIDER=openai             # openai | sarvam
SARVAM_API_KEY=

# Storage (Phase 1). Leave STORAGE_ENDPOINT empty to store files in STORAGE_LOCAL_DIR.
STORAGE_ENDPOINT=               # e.g. https://<account>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_LOCAL_DIR=.data/storage

# Payments (Phase 4, 6)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email, push, errors (Phase 3, 6)
RESEND_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SENTRY_DSN=

# Dashboard (read by Vite at build time; must start with VITE_)
VITE_API_URL=http://localhost:4000
